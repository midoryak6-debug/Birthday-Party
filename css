.extra-photo {
  width: 75%;
  max-width: 300px;
  margin: 35px auto 25px;
  padding: 9px;
  background: #fff;
  border: 1px solid #eee5e8;
  box-shadow: 0 5px 18px rgba(80, 50, 60, .12);
  transform: rotate(-2deg);
}

.extra-photo img {
  display: block;
  width: 100%;
  height: 280px;
  object-fit: cover;
  object-position: center;
}